---
import siteSettings from '../data/site-settings.json';
import type { ServicePage } from '../data/service-page-types';

interface Props {
  service: ServicePage;
  allServices: ServicePage[];
  lang?: 'fr' | 'en';
}

const { service, allServices, lang = 'fr' } = Astro.props as Props;
const otherServices = allServices.filter((item) => item.slug !== service.slug && item.slug !== 'vente-achat' && item.slug !== 'buying-selling');
const isEnglish = lang === 'en';
const contactHref = isEnglish ? '/en/contact/' : '/contact/';
const chooseServiceHref = isEnglish ? '/en/choose-service/' : '/choisir-service/';
const projectsHref = isEnglish ? '/en/realisations/' : '/realisations/';
const inspectionHref = isEnglish ? '/en/services/inspection/' : '/services/inspection/';
const servicesHref = isEnglish ? '/en/services/' : '/services/';
const serviceHref = (slug: string) => isEnglish ? `/en/services/${slug}/` : `/services/${slug}/`;
const localGuide = isEnglish
  ? service.slug === 'inspection' || service.slug === 'repair'
    ? {
        href: '/en/areas/rv-water-leak-gatineau/',
        title: 'RV water leak in Gatineau',
        copy: 'Visit the local page focused on water leaks, moisture, seals, and the right next step in Gatineau.'
      }
    : service.slug === 'maintenance'
      ? {
          href: '/en/areas/rv-maintenance-gatineau/',
          title: 'RV maintenance in Gatineau',
          copy: 'Use the local maintenance page if your need involves preventive maintenance, diagnosis, comfort systems, electrical systems, seals, roof, or membrane care in Gatineau.'
        }
      : null
  : service.slug === 'inspection' || service.slug === 'reparation'
    ? {
        href: '/zones/fuite-eau-vr-gatineau/',
        title: "Fuite d'eau de VR à Gatineau",
        copy: "Consultez la page locale dédiée si votre priorité est une fuite d'eau, l'humidité ou des joints suspects à Gatineau."
      }
    : service.slug === 'entretien'
      ? {
          href: '/zones/entretien-vr-gatineau/',
          title: 'Entretien de VR à Gatineau',
          copy: "Utilisez la page locale d'entretien si votre besoin touche l'entretien préventif, le diagnostic, la climatisation, le chauffage, l'électricité, l'électronique, les joints, la toiture ou la membrane à Gatineau."
        }
      : null;
const serviceAreas = isEnglish
  ? ['Canada', 'Quebec', 'Ontario', 'Ottawa']
  : ['Canada', 'Québec', 'Ontario', 'Ottawa'];
const serviceGuidanceCopy = isEnglish
  ? service.slug === 'solar-panel-installation'
    ? 'We can help you define the right solar, lithium, charging and monitoring setup for the way you actually travel.'
    : 'We can help you understand the situation, choose the right service and decide on the next useful step for your RV.'
  : service.slug === 'modification-amenagement'
    ? "On peut vous aider à cadrer le projet, prioriser les systèmes à modifier et choisir une solution cohérente avec votre VR."
    : service.slug === 'van-life'
      ? "On peut vous aider à définir le niveau de conversion, les systèmes essentiels et les contraintes réelles de votre van."
      : service.slug === 'installation-panneaux-solaires'
        ? "On peut vous aider à choisir le bon niveau de solaire, lithium, recharge et monitoring selon votre façon de voyager."
        : "On peut vous aider à comprendre la situation, à choisir le bon service et à décider de la prochaine étape utile pour votre VR.";
const sideGuidanceCopy = isEnglish
  ? service.slug === 'solar-panel-installation'
    ? 'We can point you toward the right solar, lithium or charging setup based on your vehicle and power needs.'
    : 'We can point you toward inspection, maintenance or repair based on the actual condition of the vehicle.'
  : service.slug === 'modification-amenagement'
    ? "On peut vous orienter vers une modification intérieure, une mise à niveau solaire/lithium ou un projet sur mesure selon votre véhicule."
    : service.slug === 'van-life'
      ? "On peut vous orienter vers une conversion essentielle, aventure ou sur mesure selon le véhicule, l'usage et le budget."
      : service.slug === 'installation-panneaux-solaires'
        ? "On peut vous orienter vers le bon système solaire, lithium ou recharge selon votre VR et votre consommation."
        : "On peut vous orienter vers une inspection, un entretien ou une réparation selon l'état du véhicule.";
const baseHelpfulLinks = isEnglish
  ? [
      {
        href: contactHref,
        title: 'Contact us about your RV',
        copy: 'Describe the issue, the vehicle, and your situation to get the right next step.'
      },
      {
        href: projectsHref,
        title: 'See real workshop projects',
        copy: 'Browse examples of repairs, restoration work, and before-and-after improvements.'
      },
      {
        href: inspectionHref,
        title: 'Inspection before buying or selling',
        copy: 'If your situation involves a transaction, start with the inspection section to clarify the real condition of the vehicle.'
      },
      {
        href: chooseServiceHref,
        title: 'Which service fits best?',
        copy: 'Use our guidance page if you are not sure whether you need modification, Van Life, solar, inspection, maintenance, or repair.'
      },
      {
        href: servicesHref,
        title: 'Compare our other services',
        copy: 'If this service is close but not exact, review the full list to choose the best fit.'
      }
    ]
  : [
      {
        href: contactHref,
        title: 'Parlez-nous de votre VR',
        copy: 'Décrivez le problème, le véhicule et votre situation pour obtenir la bonne prochaine étape.'
      },
      {
        href: projectsHref,
        title: 'Voir des interventions réelles',
        copy: 'Consultez des exemples de réparations, de remises en état et d’améliorations avant-après.'
      },
      {
        href: inspectionHref,
        title: 'Inspection avant achat ou vente',
        copy: 'Si votre situation touche une transaction, commencez par la section inspection pour clarifier l’état réel du véhicule.'
      },
      {
        href: chooseServiceHref,
        title: 'Quel service choisir ?',
        copy: 'Utilisez notre page d’orientation si vous hésitez entre modification, Van Life, solaire, inspection, entretien ou réparation.'
      },
      {
        href: servicesHref,
        title: 'Comparer les autres services',
        copy: 'Si ce service est proche de votre besoin sans être exact, parcourez la liste complète.'
      }
    ];
const helpfulLinks = [...(localGuide ? [localGuide] : []), ...baseHelpfulLinks];
const proofStats = service.proofStats ?? [];
const proofPoints = service.proofPoints ?? [];
const caseStudies = service.caseStudies ?? [];
const fallbackProofContent = isEnglish
  ? ({
      inspection: {
        title: 'Why this inspection is often the best first move',
        intro: 'When the source of a leak is still unclear, the most expensive mistake is usually waiting or booking the wrong type of work first.',
        stats: [
          { value: '$49.99', label: 'Workshop inspection' },
          { value: '$149.99', label: 'Mobile inspection within 40 km' },
          { value: 'Moisture meter', label: 'Included to support visual findings' }
        ],
        points: [
          { title: 'Quick to trigger', text: 'It gives you a useful answer fast when the issue still looks like a doubt rather than a confirmed repair file.' },
          { title: 'Cost-oriented', text: 'Catching water early can keep a tired seal from turning into walls, flooring, or interior rebuild work.' },
          { title: 'Clear next step', text: 'It helps separate inspection, maintenance, and repair instead of blending them together.' }
        ]
      },
      maintenance: {
        title: 'What good maintenance protects',
        intro: 'Maintenance is not cosmetic spending. It is what keeps water out and avoids the roof, wall, and flooring files that start with tired sealing points.',
        stats: [
          { value: '2x / year', label: 'Recommended rhythm before and after the season' },
          { value: 'Wall + roof', label: 'Seals and exposed areas covered' },
          { value: 'Workshop or mobile', label: 'Depending on the assignment' }
        ],
        points: [
          { title: 'Prevention before repair', text: 'Working on seals at the right time usually costs far less than opening a real water-damage file later.' },
          { title: 'Roof-first logic', text: 'Roof surfaces, openings, and membranes are among the first areas where prevention pays off.' },
          { title: 'Better seasonal timing', text: 'Maintenance reduces last-minute surprises before travel or after storage.' }
        ]
      },
      repair: {
        title: 'What matters in a real water-damage repair',
        intro: 'A real repair is more than making a surface look better. It starts with the source, treats the affected materials, and restores the vehicle in a credible way.',
        stats: [
          { value: 'Roof to floor', label: 'Work on the areas affected by water' },
          { value: 'Insurance or private', label: 'Approach adjusted to your file' },
          { value: 'Source first', label: 'Diagnosis before rebuild work' }
        ],
        points: [
          { title: 'Cause before cosmetics', text: 'The goal is to avoid closing a damaged area without really addressing where the water came from.' },
          { title: 'Materials treated as a whole', text: 'Roof, walls, flooring, coverings, and interior sections often have to be understood together.' },
          { title: 'Clearer repair logic', text: 'You get a more defensible path for private work or for an insurance-backed file.' }
        ]
      },
      'buying-selling': {
        title: 'What makes this service valuable before a transaction',
        intro: 'Buying and selling decisions are easier when the vehicle condition is clearer, the priorities are identified, and the presentation is more credible.',
        stats: [
          { value: 'Buyer or seller', label: 'Support adapted to the transaction side' },
          { value: 'Inspection + prep', label: 'Useful before listing or before purchase' },
          { value: 'Priority fixes', label: 'Focus on the most useful corrections first' }
        ],
        points: [
          { title: 'Better price logic', text: 'A more clearly documented vehicle is easier to price, defend, or negotiate.' },
          { title: 'Less guesswork', text: 'It helps separate cosmetic work from real structural or water-related concerns.' },
          { title: 'Clearer next step', text: 'You can decide more rationally whether to repair, buy, sell, or postpone.' }
        ]
      }
    } as const)[service.slug]
  : ({
      inspection: {
        title: 'Pourquoi cette inspection est souvent la meilleure première étape',
        intro: "Quand la source d'une fuite n'est pas claire, l'erreur la plus coûteuse est souvent d'attendre ou de réserver le mauvais type de travail en premier.",
        stats: [
          { value: 'Gratuite', label: 'Sans rendez-vous en atelier' },
          { value: 'Tarif variable', label: 'Inspection sur la route selon le déplacement' },
          { value: 'Humidimètre', label: 'Inclus pour appuyer le constat visuel' }
        ],
        points: [
          { title: 'Rapide à déclencher', text: "Elle donne une réponse utile rapidement quand le problème ressemble encore à un doute plutôt qu'à un vrai dossier de réparation." },
          { title: 'Orientée coût évité', text: "Repérer l'eau tôt évite qu'un joint fatigué devienne un mur, un plancher ou une reprise intérieure." },
          { title: 'Bonne prochaine étape', text: "Elle aide à séparer inspection, entretien et réparation au lieu de tout mélanger." }
        ]
      },
      entretien: {
        title: 'Ce que protège un bon entretien',
        intro: "L'entretien n'est pas une dépense cosmétique. C'est ce qui garde l'eau à l'extérieur et ce qui évite les dossiers de toiture, de murs et de plancher.",
        stats: [
          { value: '2x / an', label: 'Rythme recommandé avant et après saison' },
          { value: 'Mur + toit', label: 'Joints et zones exposées traités' },
          { value: 'Atelier ou mobile', label: "Selon le type d'intervention" }
        ],
        points: [
          { title: 'Prévenir avant réparer', text: "Reprendre les joints au bon moment coûte souvent bien moins qu'un vrai dossier de dommages d'eau." },
          { title: 'Logique toit en premier', text: 'Toiture, ouvertures et membrane font partie des zones où la prévention paie le plus.' },
          { title: 'Meilleur rythme de saison', text: "L'entretien réduit les mauvaises surprises juste avant les voyages ou après l'entreposage." }
        ]
      },
      reparation: {
        title: "Ce qui compte dans une vraie réparation d'infiltration",
        intro: "Une vraie réparation ne consiste pas seulement à améliorer l'apparence d'une surface. Elle part de la source, traite les matériaux touchés et remet le véhicule dans un état crédible.",
        stats: [
          { value: 'Toit à plancher', label: "Intervention sur les zones touchées par l'eau" },
          { value: 'Assurance ou privé', label: 'Approche adaptée à votre dossier' },
          { value: 'Source en premier', label: 'Diagnostic avant reconstruction' }
        ],
        points: [
          { title: 'Cause avant cosmétique', text: "Le but est d'éviter de refermer une zone touchée sans traiter la vraie origine de l'eau." },
          { title: 'Matériaux vus ensemble', text: 'Toit, murs, plancher, revêtements et sections intérieures doivent souvent être compris ensemble.' },
          { title: 'Démarche plus claire', text: "Vous obtenez une logique de réparation plus défendable, en privé comme en assurance." }
        ]
      },
      'vente-achat': {
        title: 'Ce qui donne de la valeur à ce service avant transaction',
        intro: "Acheter ou vendre devient plus simple quand l'état du véhicule est plus clair, que les priorités sont identifiées et que la présentation inspire davantage confiance.",
        stats: [
          { value: 'Acheteur ou vendeur', label: 'Accompagnement selon le côté de la transaction' },
          { value: 'Inspection + préparation', label: 'Utile avant achat ou mise en vente' },
          { value: 'Correctifs prioritaires', label: 'Focus sur les bonnes actions en premier' }
        ],
        points: [
          { title: 'Prix plus défendable', text: 'Un véhicule mieux documenté est plus facile à afficher, expliquer ou négocier.' },
          { title: 'Moins de zones grises', text: 'Le service aide à distinguer le cosmétique des vrais enjeux structurels ou liés à l’eau.' },
          { title: 'Décision plus claire', text: 'Vous pouvez décider plus rationnellement entre réparer, acheter, vendre ou attendre.' }
        ]
      }
    } as const)[service.slug];
const resolvedProofTitle = service.proofTitle ?? fallbackProofContent?.title;
const resolvedProofIntro = service.proofIntro ?? fallbackProofContent?.intro;
const resolvedProofStats = proofStats.length > 0 ? proofStats : fallbackProofContent?.stats ?? [];
const resolvedProofPoints = proofPoints.length > 0 ? proofPoints : fallbackProofContent?.points ?? [];
const showProofSection = isEnglish || !['entretien', 'reparation'].includes(service.slug);
const rexosealPanel = isEnglish
  ? service.slug === 'maintenance'
    ? {
        eyebrow: 'Roof protection service',
        title: 'Rexoseal work offered through our maintenance service',
        intro: 'For some roof and membrane files, we offer <strong>Rexoseal</strong> work directly through the workshop as part of an RV maintenance or roof-protection plan.',
        points: [
          'Used on selected roof or membrane files when the surface and support condition are a good fit.',
          'Integrated into the maintenance plan when the goal is to protect, restore, or reinforce vulnerable roof areas.',
          'Validated by us first so the solution matches the vehicle instead of applying the same approach to every roof.'
        ]
      }
    : null
  : service.slug === 'entretien'
    ? {
        eyebrow: 'Service de protection de toiture',
        title: 'Travaux Rexoseal offerts dans notre service d’entretien',
        intro: 'Pour certains dossiers de toiture et de membrane, nous offrons directement des travaux avec <strong>Rexoseal</strong> dans le cadre d’un entretien ou d’une remise en protection du VR.',
        points: [
          'Utilisé sur certains dossiers de toiture ou de membrane quand la surface et l’état du support s’y prêtent.',
          'Intégré au plan d’entretien quand l’objectif est de protéger, restaurer ou renforcer des zones de toit plus vulnérables.',
          'Validé par l’atelier avant recommandation pour choisir une solution cohérente avec le véhicule plutôt qu’une approche unique pour tous les toits.'
        ]
      }
    : null;
const localServiceFocus = isEnglish
  ? service.slug === 'rv-modification-custom-builds'
    ? `Clinique du VR delivers <strong>RV modification and custom builds</strong> from its <strong>Gatineau workshop</strong> and can frame selected projects for clients across <u>Canada</u>. This page is meant to clarify <strong>solar</strong>, <strong>lithium</strong>, <strong>Victron Energy</strong>, <strong>Bluetti</strong>, interior upgrades, storage, heating, water, ventilation and other <strong>custom RV projects</strong> before workshop planning.`
    : service.slug === 'van-life-conversion'
      ? `Clinique du VR delivers <strong>Van Life conversions</strong> from its <strong>Gatineau workshop</strong> and can frame selected projects for clients across <u>Canada</u>. This page is meant to clarify partial or complete van conversions, insulation, flooring, furniture, water, heating, ventilation, solar, lithium and 3- or 4-season systems.`
      : service.slug === 'solar-panel-installation'
        ? `Clinique du VR delivers <strong>RV solar and lithium installations</strong> from its <strong>Gatineau workshop</strong> and can frame selected autonomy projects for clients across <u>Canada</u>. This page is meant to clarify <strong>Victron Energy</strong>, <strong>Bluetti</strong>, MPPT, inverters, DC-DC charging, shore power, monitoring and off-grid power needs.`
        : service.slug === 'maintenance'
    ? `Clinique du VR delivers <strong>${service.navLabel}</strong> from its <strong>Gatineau workshop</strong> and supports clients from <u>Outaouais</u>, <u>Ottawa</u>, and the <u>Laurentides</u> depending on the assignment. This page is meant to clarify the right next step for <strong>preventive maintenance</strong>, <strong>diagnosis</strong>, <strong>comfort systems</strong>, <strong>electrical systems</strong>, <strong>roof condition</strong>, <strong>seals</strong>, and other RV maintenance needs.`
    : service.slug === 'repair'
      ? `Clinique du VR delivers <strong>${service.navLabel}</strong> from its <strong>Gatineau workshop</strong> and supports clients from <u>Outaouais</u>, <u>Ottawa</u>, and the <u>Laurentides</u> depending on the assignment. This page is meant to clarify the right repair path for <strong>diagnosis</strong>, <strong>comfort systems</strong>, <strong>electrical systems</strong>, <strong>electronics</strong>, <strong>plumbing</strong>, <strong>propane</strong>, <strong>roof condition</strong>, and water-related damage.`
    : service.slug === 'fiberglass-gelcoat-repair'
      ? `Clinique du VR delivers <strong>${service.navLabel}</strong> from its <strong>Gatineau workshop</strong> and supports clients depending on the assignment. This page is meant to clarify <strong>fiberglass repair</strong>, <strong>gelcoat touch-ups</strong>, cracks, chips, impacts and finish restoration for <strong>RVs</strong> and <strong>boats</strong>.`
    : service.slug === 'solar-panel-installation'
      ? `Clinique du VR delivers <strong>${service.navLabel}</strong> from its <strong>Gatineau workshop</strong> and supports clients from <u>Outaouais</u>, <u>Ottawa</u>, and the <u>Laurentides</u> depending on the assignment. This page is meant to clarify <strong>RV solar panels</strong>, <strong>lithium batteries</strong>, <strong>Victron Energy</strong>, <strong>Bluetti</strong>, charging, monitoring and off-grid power needs.`
      : `Clinique du VR delivers <strong>${service.navLabel}</strong> from its <strong>Gatineau workshop</strong> and supports clients from <u>Outaouais</u>, <u>Ottawa</u>, and the <u>Laurentides</u> depending on the assignment. This page is meant to clarify the right next step when the issue involves <strong>water intrusion</strong>, <strong>roof condition</strong>, <strong>seals</strong>, or an <strong>RV inspection / maintenance / repair decision</strong>.`
  : service.slug === 'entretien'
    ? `Clinique du VR prend en charge <strong>${service.navLabel}</strong> à partir de son <strong>atelier de Gatineau</strong> et accompagne aussi les demandes venant de <u>l’Outaouais</u>, d’<u>Ottawa</u> et des <u>Laurentides</u> selon le mandat. Cette page sert à clarifier la bonne prochaine étape pour l’<strong>entretien préventif</strong>, le <strong>diagnostic</strong>, la <strong>climatisation</strong>, le <strong>chauffage</strong>, l’<strong>électricité</strong>, l’<strong>électronique</strong>, la <strong>toiture</strong>, les <strong>joints</strong> et les autres besoins d’entretien de VR.`
    : service.slug === 'reparation'
      ? `Clinique du VR prend en charge <strong>${service.navLabel}</strong> à partir de son <strong>atelier de Gatineau</strong> et accompagne aussi les demandes venant de <u>l’Outaouais</u>, d’<u>Ottawa</u> et des <u>Laurentides</u> selon le mandat. Cette page sert à clarifier la bonne réparation pour le <strong>diagnostic</strong>, la <strong>climatisation</strong>, le <strong>chauffage</strong>, l’<strong>électricité</strong>, l’<strong>électronique</strong>, la <strong>plomberie</strong>, le <strong>propane</strong>, la <strong>toiture</strong> et les dommages liés à l’eau.`
    : service.slug === 'modification-amenagement'
      ? `Clinique du VR prend en charge la <strong>modification et l'aménagement de VR</strong> à partir de son <strong>atelier de Gatineau</strong> et peut cadrer certains projets venant de partout au <u>Canada</u>. Cette page sert à clarifier les projets de <strong>panneaux solaires</strong>, <strong>batteries lithium</strong>, <strong>Victron Energy</strong>, <strong>Bluetti</strong>, autonomie énergétique, chauffage, climatisation, plomberie, mobilier, rangement, lits, cuisines et autres <strong>projets sur mesure</strong> avant planification en atelier.`
      : service.slug === 'reparation-fibre-verre-gelcoat'
        ? `Clinique du VR prend en charge la <strong>réparation de fibre de verre et gelcoat</strong> à partir de son <strong>atelier de Gatineau</strong> selon le mandat. Cette page sert à clarifier les besoins en <strong>réparation de fibre de verre</strong>, <strong>retouche gelcoat</strong>, fissures, éclats, impacts et remise en état de finition pour <strong>VR</strong> et <strong>bateaux</strong>.`
      : service.slug === 'van-life'
        ? `Clinique du VR prend en charge l'<strong>aménagement Van Life</strong> à partir de son <strong>atelier de Gatineau</strong> et peut cadrer certains projets venant de partout au <u>Canada</u>. Cette page sert à clarifier les conversions partielles ou complètes, l'isolation, le plancher, le mobilier, l'eau, le chauffage, la ventilation, le solaire, le lithium et les solutions 3 ou 4 saisons.`
        : service.slug === 'installation-panneaux-solaires'
          ? `Clinique du VR prend en charge l'<strong>installation de panneaux solaires et batteries lithium</strong> à partir de son <strong>atelier de Gatineau</strong> et peut cadrer certains projets d'autonomie venant de partout au <u>Canada</u>. Cette page sert à clarifier les besoins en <strong>Victron Energy</strong>, <strong>Bluetti</strong>, MPPT, onduleurs, DC-DC, recharge par alternateur, Shore Power, monitoring et autonomie énergétique.`
          : `Clinique du VR prend en charge <strong>${service.navLabel}</strong> à partir de son <strong>atelier de Gatineau</strong> et accompagne aussi les demandes venant de <u>l’Outaouais</u>, d’<u>Ottawa</u> et des <u>Laurentides</u> selon le mandat. Cette page sert à clarifier la bonne prochaine étape quand le besoin touche une <strong>infiltration d’eau</strong>, la <strong>toiture</strong>, les <strong>joints</strong> ou un choix entre <strong>inspection, entretien et réparation de VR</strong>.`;
---

<main>
  <section class="service-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{service.eyebrow}</p>
        <h1 class:list={[
          (service.slug === 'inspection' || service.slug === 'entretien' || service.slug === 'maintenance' || service.slug === 'rexoseal' || service.slug === 'reparation' || service.slug === 'repair' || service.slug === 'reparation-fibre-verre-gelcoat' || service.slug === 'fiberglass-gelcoat-repair' || service.slug === 'installation-panneaux-solaires' || service.slug === 'solar-panel-installation' || service.slug === 'modification-amenagement' || service.slug === 'van-life') && 'hero-title-wide',
          (service.slug === 'modification-amenagement' || service.slug === 'van-life' || service.slug === 'reparation-fibre-verre-gelcoat' || service.slug === 'fiberglass-gelcoat-repair') && 'hero-title-balanced',
          service.slug === 'inspection' && 'hero-title-wider'
        ]}>{service.h1}</h1>
        <p class="opening" set:html={service.opening} />
        <p class="lead" set:html={service.lead} />
        <p class="intro" set:html={service.intro} />
        {service.heroPromise && <p class="hero-promise" set:html={service.heroPromise} />}

        <div class="hero-badges">
          {service.highlights.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </div>

      <aside class="hero-card">
        <div class="hero-icon">
          <i class={service.icon}></i>
        </div>
        <h2>{isEnglish ? 'Need a practical starting point?' : 'Besoin d’un point de départ clair?'}</h2>
        <p>{serviceGuidanceCopy}</p>
        <a class="hero-link" href={contactHref}>{isEnglish ? 'Talk to us about your RV' : 'Parler de votre VR'}</a>
      </aside>
    </div>
  </section>

  <section class="service-body">
      <div class="container body-grid">
      <article class="service-main">
        {showProofSection && (resolvedProofStats.length > 0 || resolvedProofPoints.length > 0) && (
          <section class="content-card alt">
            <h2>{resolvedProofTitle ?? (isEnglish ? 'Proof and concrete outcomes' : 'Preuves et résultats concrets')}</h2>
            {resolvedProofIntro && <p class="section-copy" set:html={resolvedProofIntro} />}
            {resolvedProofStats.length > 0 && (
              <div class="proof-stats-grid">
                {resolvedProofStats.map((item) => (
