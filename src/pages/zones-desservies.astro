---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localAreaPagesFr } from '../data/local-area-pages';
import { buildBreadcrumbSchema, buildCollectionPageSchema, buildWebSiteSchema } from '../lib/seo';
import siteSettings from '../data/site-settings.json';

const schemas = [
  buildWebSiteSchema(),
  buildCollectionPageSchema({
    name: 'Zones desservies | Clinique du VR',
    description: 'Zones desservies par Clinique du VR depuis Gatineau, avec projets sélectionnés de modification, Van Life et solaire partout au Canada.',
    path: '/zones-desservies/'
  }),
  buildBreadcrumbSchema([
    { name: 'Accueil', path: '/' },
    { name: 'Zones desservies' }
  ])
];
---

<Layout
  title="Zones desservies VR | Canada, Québec, Ontario et Gatineau | Clinique du VR"
  description="Découvrez les zones desservies par Clinique du VR depuis Gatineau pour les demandes locales et les projets sélectionnés de modification, Van Life et solaire au Canada."
  canonicalPath="/zones-desservies/"
  frPath="/zones-desservies/"
  enPath="/en/service-areas/"
  schemas={schemas}
>
  <Header />

  <main>
    <section class="interior-hero">
      <div class="container interior-hero-grid">
        <div class="interior-hero-copy">
          <p class="interior-eyebrow">Canada • Québec • Ontario</p>
          <h1>Zones desservies et projets Canada</h1>
          <p class="interior-lead">Notre atelier est à Gatineau. Les demandes d'inspection, d'entretien et de réparation restent surtout régionales, tandis que les projets de modification, Van Life, solaire et lithium peuvent être cadrés avec des clients de partout au Canada selon la logistique vers l'atelier.</p>
        </div>

        <aside class="interior-hero-card">
          <div class="interior-hero-icon">
            <i class="fas fa-map-location-dot"></i>
          </div>
          <h2>Besoin d'un point de départ clair?</h2>
          <p>On peut vous aider à comprendre la situation, à choisir le bon service et à décider de la prochaine étape utile pour votre VR.</p>
          <a class="interior-hero-link" href="/contact/">Parler de votre VR</a>
        </aside>
      </div>
    </section>

    <section class="interior-section">
      <div class="container interior-body-grid">
        <article class="content-main">
          <div class="areas-grid">
          {localAreaPagesFr.map((page) => (
            <a class="area-card" href={`/zones/${page.slug}/`}>
              <p class="area-name">{page.area}</p>
              <h2>{page.h1}</h2>
              <p>{page.intro}</p>
              <span>Voir la page locale</span>
            </a>
          ))}
          </div>

          <div class="content-grid">
          <article class="interior-card">
            <h2>Projets partout au Canada</h2>
            <p>Pour les projets de <strong>modification VR</strong>, <strong>aménagement Van Life</strong>, <strong>solaire</strong> et <strong>lithium</strong>, nous pouvons commencer à distance avec votre ville, province, véhicule, photos, budget et échéancier. Les travaux sont ensuite planifiés selon la faisabilité et la possibilité d'amener le véhicule à Gatineau.</p>
          </article>

          <article class="interior-card">
            <h2>Quand une page locale est utile</h2>
            <p>Une page locale est utile quand vous cherchez un service précis avec une réalité géographique claire: fuite d’eau à Gatineau, entretien en Outaouais, réparation pour Ottawa ou infiltration sur une roulotte dans les Laurentides.</p>
          </article>

          <article class="interior-card">
            <h2>Repère GEO local</h2>
            <p class="seo-keyline"><strong>Gatineau</strong> reste notre base atelier. Les pages locales servent à relier cette base réelle aux recherches de <u>l’Outaouais</u>, d’<u>Ottawa</u> et des <u>Laurentides</u>, tandis que les services de <strong>modification</strong>, <strong>Van Life</strong>, <strong>solaire</strong> et <strong>lithium</strong> peuvent viser des projets sélectionnés au <u>Canada</u>.</p>
          </article>

          <article class="interior-card">
            <h2>Atelier à Gatineau, accompagnement régional</h2>
            <p>Le point de départ reste notre atelier de Gatineau. Selon le service demandé, nous pouvons orienter vers une inspection, un entretien ou une réparation, puis confirmer la meilleure prochaine étape avant réservation.</p>
          </article>

          <article class="interior-card">
            <h2>Avant de réserver</h2>
            <p>Si vous hésitez encore entre plusieurs services, commencez par notre page d’orientation ou contactez-nous avec quelques photos du VR, la ville, le type de problème et le niveau d’urgence.</p>
            <p class="actions"><a href="/choisir-service/">Quel service choisir ?</a> · <a href="/contact/">Contacter l’atelier</a></p>
          </article>
          </div>
        </article>

        <aside class="interior-side-panel">
          <div class="interior-side-card interior-side-card-primary">
            <h3>Besoin d'un avis rapide?</h3>
            <p>On peut vous orienter vers une inspection, un entretien ou une réparation selon l'état du véhicule.</p>
            <a class="interior-side-button" href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a>
          </div>

          <div class="interior-side-card">
            <h3>Autres services</h3>
            <nav class="interior-service-nav" aria-label="Autres services">
              <a href="/services/inspection/"><i class="fas fa-clipboard-check"></i><span>Inspection</span></a>
              <a href="/services/entretien/"><i class="fas fa-screwdriver-wrench"></i><span>Entretien</span></a>
              <a href="/services/reparation/"><i class="fas fa-toolbox"></i><span>Réparation</span></a>
              <a href="/services/modification-amenagement/"><i class="fas fa-sliders"></i><span>Modification & aménagement</span></a>
            </nav>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .content-main { display: grid; gap: 1.5rem; }
  .areas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .area-card { background: white; border-radius: 22px; padding: 1.75rem; box-shadow: 0 16px 34px rgba(24, 40, 61, 0.08); }
  .area-name { color: var(--brand-green-dark); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.82rem; }
  .area-card h2 { font-size: 1.2rem; margin: 0.45rem 0 0.8rem; }
  .area-card p { color: var(--brand-muted); }
  .area-card span { display: inline-block; margin-top: 1rem; font-weight: 700; }
  .content-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-top: 2rem; }
  .interior-card p { margin-top: 0.75rem; color: var(--brand-muted); }
  .actions { font-weight: 700; }
</style>
