---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildLocalBusinessSchema, buildWebSiteSchema } from '../lib/seo';
import siteSettings from '../data/site-settings.json';
import homePage from '../data/home-page.json';

const isFormConfigured = Boolean(siteSettings.email?.trim());
const successUrl = '/merci/';
const formName = 'home-contact-fr-v2';
const schemas = [
  buildWebSiteSchema(),
  buildLocalBusinessSchema({
    telephone: siteSettings.phone.href,
    email: siteSettings.email,
    facebookUrl: siteSettings.facebookUrl,
    tiktokUrl: siteSettings.tiktokUrl
  })
];

const meta = {
  title: homePage.metaTitle,
  description: homePage.metaDescription
};
const heroPillLabels = homePage.hero.title.split(' • ');

---

<Layout title={meta.title} description={meta.description} canonicalPath="/" frPath="/" enPath="/en/" schemas={schemas}>
  <Header />

  <main>
    <section class="hero">
      <div class="hero-content">
        <img class="hero-logo" src={siteSettings.brandImage} alt={homePage.hero.logoAlt} />
        <p class="hero-eyebrow">Clinique du VR</p>
        <h1>Réparation, modification et aménagement</h1>
        <div class="hero-pill-row" aria-label={homePage.hero.title}>
          {heroPillLabels.map((label) => (
            <span>{label}</span>
          ))}
        </div>
        <p class="hero-tagline">{homePage.hero.tagline}</p>
        <div class="hero-actions">
          <a href="/contact/#formulaire-soumission">Discuter de mon projet</a>
          <a href="/contact/#formulaire-soumission">Demander une soumission</a>
        </div>
      </div>
    </section>

    <!-- ABOUT & SERVICES INTRO -->
    <section class="intro-section">
      <div class="container intro-grid">
        <div class="intro-card">
          {homePage.introCard.icon && (
            <div class="card-icon">
              <i class={homePage.introCard.icon}></i>
            </div>
          )}
          <h2>{homePage.introCard.heading}</h2>
          <p set:html={homePage.introCard.body} />
        </div>
      </div>
    </section>

    <!-- SERVICES OVERVIEW -->
    <section class="services-overview">
      <div class="container">
        <h2>{homePage.servicesOverview.title}</h2>
        <div class="services-grid">
          {homePage.servicesOverview.items.map((item) => (
            <a href={item.href} class:list={['service-item', !item.icon && 'service-item--no-icon']}>
              {item.icon && <i class={item.icon}></i>}
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="parts-store">
      <div class="container parts-store-card">
        <div class="parts-store-icon" aria-hidden="true">
          <i class="fas fa-store"></i>
        </div>
        <div class="parts-store-content">
          <p class="parts-store-eyebrow">{homePage.partsStore.eyebrow}</p>
          <h2>{homePage.partsStore.heading}</h2>
          <p class="parts-store-copy">{homePage.partsStore.body}</p>
          <div class="parts-store-items">
            {homePage.partsStore.items.map((item) => (
              item.href ? (
                <a href={item.href}><i class={item.icon} aria-hidden="true"></i>{item.label}</a>
              ) : (
                <span><i class={item.icon} aria-hidden="true"></i>{item.label}</span>
              )
            ))}
          </div>
          <a class="parts-store-cta" href="/magasin/">
            <i class="fas fa-store" aria-hidden="true"></i>
            {homePage.partsStore.ctaLabel}
          </a>
        </div>
      </div>
    </section>

    <section class="seo-copy">
      <div class="container seo-grid">
        {homePage.seoSections.map((section) => (
          <div>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section class="contact-section">
      <div class="container contact-grid">
        <div class="contact-form-wrapper">
          <h2>{homePage.contactForm.heading}</h2>
          {!isFormConfigured && (
            <p class="form-note">{homePage.contactForm.unconfiguredNote}</p>
          )}
          <form name={formName} action={isFormConfigured ? successUrl : undefined} method="POST" data-netlify="true" netlify-honeypot="bot-field" data-netlify-form>
            <input type="hidden" name="form-name" value={formName} />
            <input type="hidden" name="bot-field" />
            <input type="hidden" name="Page" value="Accueil FR" />
            <label class="sr-only" for="home-name">{homePage.contactForm.namePlaceholder}</label>
            <input id="home-name" type="text" name="Nom complet" placeholder={homePage.contactForm.namePlaceholder} required />
            <label class="sr-only" for="home-email">{homePage.contactForm.emailPlaceholder}</label>
            <input id="home-email" type="email" name="Courriel" placeholder={homePage.contactForm.emailPlaceholder} required />
            <label class="sr-only" for="home-subject">{homePage.contactForm.subjectPlaceholder}</label>
            <input id="home-subject" type="text" name="Sujet" placeholder={homePage.contactForm.subjectPlaceholder} required />
            <label class="sr-only" for="home-message">{homePage.contactForm.messagePlaceholder}</label>
            <textarea id="home-message" name="Message" placeholder={homePage.contactForm.messagePlaceholder} rows="5" required></textarea>
            <button type="submit" disabled={!isFormConfigured}>{homePage.contactForm.submitLabel}</button>
          </form>
        </div>

        <div class="contact-info">
          <h3>{homePage.contactPanel.heading}</h3>
          <p><strong>Téléphone:</strong> <a href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a></p>
          <p><strong>Email:</strong> <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a></p>
          <p><strong>Adresse:</strong> {siteSettings.address.fr}</p>
          <p><strong>Territoire desservi:</strong> {siteSettings.serviceArea.fr}</p>
          <p><strong>Assurance:</strong> Garage et civile 2 millions | <strong>Depuis:</strong> {siteSettings.sinceYear}</p>
          <p class="cta-text">{homePage.contactPanel.ctaText}</p>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .hero {
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(180deg, rgba(12, 28, 44, 0.18), rgba(12, 28, 44, 0.66)),
      linear-gradient(135deg, #173c5f 0%, #235a70 48%, #1f5a3d 100%);
    text-align: center;
    color: white;
    padding: 2.8rem 1.5rem 3rem;
  }

  .hero-logo {
    width: min(340px, 62vw);
    height: auto;
    display: block;
    margin: 0 auto 1rem;
    border-radius: 10px;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.2));
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 0.65rem;
    padding: 0.34rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--brand-gold);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-tagline {
    font-size: 1rem;
    margin: 0.95rem auto 0;
    line-height: 1.55;
    max-width: 62ch;
    color: #eef5f7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 1.25rem;
  }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.68rem 1rem;
    border-radius: 6px;
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .hero-actions a + a {
    background: white;
  }

  .hero-actions a:hover {
    transform: translateY(-2px);
    text-decoration: none;
  }

  .hero-content h1 {
    color: white;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.05;
    font-size: clamp(2rem, 3.9vw, 3.55rem);
    letter-spacing: 0;
  }

  .hero-pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin: 0.9rem auto 0;
    max-width: 820px;
  }

  .hero-pill-row span {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0.36rem 0.62rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: white;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .hero-content {
    width: min(980px, 100%);
  }

  .intro-section {
    padding: 4rem 0;
    background: white;
  }

  .intro-grid {
    display: flex;
    justify-content: center;
  }

  .intro-card {
    text-align: center;
    max-width: 780px;
    background: linear-gradient(180deg, #f8fbf5 0%, #ffffff 100%);
    border-radius: 22px;
    padding: 2rem;
    box-shadow: 0 16px 34px rgba(24, 40, 61, 0.08);
  }

  .card-icon {
    font-size: 3rem;
    color: var(--brand-green);
    margin-bottom: 1rem;
  }

  .services-overview {
    padding: 4rem 0;
    background: var(--brand-surface);
  }

  .parts-store {
    padding: 4rem 0;
    background: white;
  }

  .parts-store-card {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-top: 2.75rem;
    padding-bottom: 2.75rem;
    border-radius: 24px;
    background:
      radial-gradient(circle at top right, rgba(242, 210, 27, 0.2), transparent 30%),
      linear-gradient(135deg, var(--brand-navy-dark), var(--brand-navy));
    color: white;
    box-shadow: 0 18px 40px rgba(24, 40, 61, 0.16);
  }

  .parts-store-icon {
    display: grid;
    place-items: center;
    width: 138px;
    height: 138px;
    margin: 0 auto;
    border-radius: 50%;
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
    font-size: 3.75rem;
  }

  .parts-store-eyebrow {
    margin-bottom: 0.35rem;
    color: var(--brand-gold);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .parts-store h2 {
    color: white;
  }

  .parts-store-copy {
    max-width: 72ch;
    margin-top: 0.75rem;
    color: #e8eef5;
  }

  .parts-store-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .parts-store-items span,
  .parts-store-items a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-weight: 700;
  }

  .parts-store-items a:hover {
    background: rgba(255, 255, 255, 0.18);
    text-decoration: none;
  }

  .parts-store-items i {
    color: var(--brand-gold);
  }

  .parts-store-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0.8rem 1.15rem;
    border-radius: 6px;
    background: var(--brand-green);
    color: white;
    font-weight: 700;
  }

  .parts-store-cta:hover {
    background: var(--brand-green-dark);
    text-decoration: none;
  }

  .seo-copy {
    padding: 4rem 0;
    background: white;
  }

  .seo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .seo-grid > div {
    background: white;
    border-radius: 22px;
    padding: 1.75rem;
    box-shadow: 0 16px 34px rgba(24, 40, 61, 0.08);
  }

  .seo-grid p {
    margin-top: 0.75rem;
    color: var(--brand-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .service-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2rem;
    background: white;
    border-radius: 22px;
    transition: all 0.3s;
    border: 2px solid transparent;
    box-shadow: 0 16px 34px rgba(24, 40, 61, 0.08);
  }

  .service-item:hover {
    border-color: var(--brand-green);
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
  }

  .service-item i {
    font-size: 2.5rem;
    color: var(--brand-navy);
  }

  .service-item--no-icon {
    gap: 0;
  }

  .contact-section {
    padding: 4rem 0;
    background: var(--brand-navy);
    color: white;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .contact-form-wrapper h2 {
    color: white;
    margin-bottom: 1.5rem;
  }

  .contact-form-wrapper,
  .contact-info {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 22px;
    padding: 1.75rem;
    box-shadow: 0 16px 34px rgba(8, 23, 40, 0.18);
  }

  .contact-form-wrapper form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-note {
    margin-bottom: 1rem;
    color: #d9e6d1;
  }

  .contact-form-wrapper input,
  .contact-form-wrapper textarea {
    padding: 12px;
    border: none;
    border-radius: 4px;
    font-family: inherit;
  }

  .contact-info h3 {
    color: var(--brand-gold);
    margin-bottom: 1rem;
  }

  .contact-info p {
    margin-bottom: 0.75rem;
  }

  .contact-info strong {
    color: #d5e4f5;
  }

  .contact-info a {
    color: white;
    font-weight: 700;
  }

  .contact-info a:hover {
    color: var(--brand-gold);
  }


  .cta-text {
    margin-top: 1.5rem;
    font-style: italic;
    color: #d9e6d1;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 0;
      padding: 1.35rem 0.9rem 1.35rem;
      align-items: center;
    }

    .hero-logo {
      width: min(220px, 58vw);
      margin: 0 auto 0.65rem;
      border-radius: 8px;
    }

    .hero-eyebrow {
      margin-bottom: 0.6rem;
      padding: 0.34rem 0.62rem;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
    }

    .hero-content h1 {
      font-size: 1.62rem;
      max-width: 16ch;
      line-height: 1.08;
    }

    .hero-tagline {
      font-size: 0.84rem;
      margin-top: 0.65rem;
      line-height: 1.42;
    }

    .hero-pill-row {
      gap: 0.38rem;
      margin-top: 0.65rem;
    }

    .hero-pill-row span {
      min-height: 28px;
      padding: 0.3rem 0.48rem;
      font-size: 0.64rem;
    }

    .hero-actions {
      gap: 0.5rem;
      margin-top: 0.85rem;
    }

    .hero-actions a {
      min-height: 36px;
      padding: 0.5rem 0.66rem;
      font-size: 0.66rem;
    }

    .intro-section,
    .services-overview,
    .parts-store,
    .seo-copy,
    .contact-section {
      padding: 1.8rem 0;
    }

    .intro-card {
      max-width: none;
      padding: 1rem;
      border-radius: 16px;
    }

    .card-icon {
      font-size: 2.35rem;
      margin-bottom: 0.8rem;
    }

    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
      margin-top: 0.7rem;
    }

    .service-item {
      padding: 0.72rem 0.62rem;
      min-height: 78px;
      border-radius: 14px;
      box-shadow: 0 6px 14px rgba(24, 40, 61, 0.05);
    }

    .service-item i {
      font-size: 1.5rem;
    }

    .service-item span {
      font-size: 0.78rem;
      text-align: center;
      line-height: 1.18;
    }

    .parts-store-card {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1.4rem 1rem;
      text-align: center;
      border-radius: 16px;
    }

    .parts-store-icon {
      width: 86px;
      height: 86px;
      font-size: 2.35rem;
    }

    .parts-store-eyebrow {
      font-size: 0.78rem;
    }

    .parts-store-copy {
      margin-top: 0.6rem;
    }

    .parts-store-items {
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .parts-store-items span,
    .parts-store-items a {
      padding: 0.45rem 0.65rem;
      font-size: 0.82rem;
    }

    .parts-store-cta {
      margin-top: 1.15rem;
    }

    .seo-grid,
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .contact-form-wrapper h2,
    .services-overview h2 {
      margin-bottom: 0.7rem;
    }

    .contact-form-wrapper,
    .contact-info,
    .seo-grid > div {
      padding: 1rem;
      border-radius: 16px;
      box-shadow: 0 6px 14px rgba(24, 40, 61, 0.05);
    }

    .contact-form-wrapper form {
      gap: 0.62rem;
    }

    .contact-form-wrapper input,
    .contact-form-wrapper textarea {
      padding: 0.7rem 0.78rem;
    }

  }
</style>
