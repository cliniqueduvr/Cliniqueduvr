---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { buildLocalBusinessSchema, buildWebSiteSchema } from '../../lib/seo';
import siteSettings from '../../data/site-settings.json';
import homePage from '../../data/home-page-en.json';

const isFormConfigured = Boolean(siteSettings.email?.trim());
const successUrl = '/en/thank-you/';
const formName = 'home-contact-en-v2';
const schemas = [
  buildWebSiteSchema(),
  buildLocalBusinessSchema({
    telephone: siteSettings.phone.href,
    email: siteSettings.email,
    facebookUrl: siteSettings.facebookUrl,
    tiktokUrl: siteSettings.tiktokUrl
  })
];

const meta = {
  title: homePage.metaTitle,
  description: homePage.metaDescription
};
---

<Layout title={meta.title} description={meta.description} lang="en-CA" canonicalPath="/en/" frPath="/" enPath="/en/" schemas={schemas}>
  <Header lang="en" />

  <main>
    <section class="hero">
      <div class="hero-content">
        <img class="hero-logo" src={siteSettings.brandImage} alt={homePage.hero.logoAlt} />
        <h1>{homePage.hero.title}</h1>
        <p class="hero-tagline">{homePage.hero.tagline}</p>
      </div>
    </section>

    <section class="intro-section">
      <div class="container intro-grid">
        <div class="intro-card">
          {homePage.introCard.icon && (
            <div class="card-icon">
              <i class={homePage.introCard.icon}></i>
            </div>
          )}
          <h2>{homePage.introCard.heading}</h2>
          <p set:html={homePage.introCard.body} />
        </div>
      </div>
    </section>

    <section class="services-overview">
      <div class="container">
        <h2>{homePage.servicesOverview.title}</h2>
        <div class="services-grid">
          {homePage.servicesOverview.items.map((item) => (
            <a href={item.href} class:list={['service-item', !item.icon && 'service-item--no-icon']}>{item.icon && <i class={item.icon}></i>}<span>{item.label}</span></a>
          ))}
        </div>
      </div>
    </section>

    <section class="parts-store">
      <div class="container parts-store-card">
        <div class="parts-store-icon" aria-hidden="true">
          <i class="fas fa-store"></i>
        </div>
        <div class="parts-store-content">
          <p class="parts-store-eyebrow">{homePage.partsStore.eyebrow}</p>
          <h2>{homePage.partsStore.heading}</h2>
          <p class="parts-store-copy">{homePage.partsStore.body}</p>
          <div class="parts-store-items">
            {homePage.partsStore.items.map((item) => (
              <span><i class={item.icon} aria-hidden="true"></i>{item.label}</span>
            ))}
          </div>
          <a class="parts-store-cta" href="/en/store/">
            <i class="fas fa-store" aria-hidden="true"></i>
            {homePage.partsStore.ctaLabel}
          </a>
        </div>
      </div>
    </section>

    <section class="seo-copy">
      <div class="container seo-grid">
        {homePage.seoSections.map((section) => (
          <div>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="contact-section">
      <div class="container contact-grid">
        <div class="contact-form-wrapper">
          <h2>{homePage.contactForm.heading}</h2>
          {!isFormConfigured && (
            <p class="form-note">{homePage.contactForm.unconfiguredNote}</p>
          )}
          <form name={formName} action={isFormConfigured ? successUrl : undefined} method="POST" data-netlify="true" netlify-honeypot="bot-field" data-netlify-form>
            <input type="hidden" name="form-name" value={formName} />
            <input type="hidden" name="bot-field" />
            <input type="hidden" name="Page" value="Home EN" />
            <label class="sr-only" for="home-name-en">{homePage.contactForm.namePlaceholder}</label>
            <input id="home-name-en" type="text" name="Full name" placeholder={homePage.contactForm.namePlaceholder} required />
            <label class="sr-only" for="home-email-en">{homePage.contactForm.emailPlaceholder}</label>
            <input id="home-email-en" type="email" name="Email" placeholder={homePage.contactForm.emailPlaceholder} required />
            <label class="sr-only" for="home-subject-en">{homePage.contactForm.subjectPlaceholder}</label>
            <input id="home-subject-en" type="text" name="Subject" placeholder={homePage.contactForm.subjectPlaceholder} required />
            <label class="sr-only" for="home-message-en">{homePage.contactForm.messagePlaceholder}</label>
            <textarea id="home-message-en" name="Message" placeholder={homePage.contactForm.messagePlaceholder} rows="5" required></textarea>
            <button type="submit" disabled={!isFormConfigured}>{homePage.contactForm.submitLabel}</button>
          </form>
        </div>

        <div class="contact-info">
          <h3>{homePage.contactPanel.heading}</h3>
          <p><strong>Phone:</strong> <a href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a></p>
          <p><strong>Email:</strong> <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a></p>
          <p><strong>Address:</strong> {siteSettings.address.en}</p>
          <p><strong>Service area:</strong> {siteSettings.serviceArea.en}</p>
          <p><strong>Insurance:</strong> $2M garage and liability | <strong>Since:</strong> {siteSettings.sinceYear}</p>
          <p class="cta-text">{homePage.contactPanel.ctaText}</p>
        </div>
      </div>
    </section>

  </main>

  <Footer lang="en" />
</Layout>

<style>
  .hero { min-height: 560px; display: flex; align-items: center; justify-content: center; text-align: center; color: white; background: radial-gradient(circle at top left, rgba(242, 210, 27, 0.16), transparent 28%), linear-gradient(135deg, var(--brand-navy-dark) 0%, #1f476d 62%, #214f33 100%); padding: 4.25rem 1.5rem 3.5rem; }
  .hero-logo { width: min(760px, 88vw); height: auto; display: block; margin: 0 auto 2rem; border-radius: 24px; filter: drop-shadow(0 18px 35px rgba(0, 0, 0, 0.25)); }
  .hero-content { width: min(1120px, 100%); }
  .hero-content h1 { color: white; max-width: 22ch; margin: 0 auto; line-height: 1.12; }
  .hero-tagline { font-size: 1.14rem; letter-spacing: 0.4px; margin: 1rem auto 0; line-height: 1.7; max-width: 58ch; }
  .intro-section { padding: 4rem 0; background: white; }
  .intro-grid { display: flex; justify-content: center; }
  .intro-card { text-align: center; max-width: 780px; background: linear-gradient(180deg, #f8fbf5 0%, #ffffff 100%); border-radius: 22px; padding: 2rem; box-shadow: 0 16px 34px rgba(24, 40, 61, 0.08); }
  .card-icon { font-size: 3rem; color: var(--brand-green); margin-bottom: 1rem; }
  .services-overview { padding: 4rem 0; background: var(--brand-surface); }
  .parts-store { padding: 4rem 0; background: white; }
  .parts-store-card { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 2.5rem; align-items: center; padding-top: 2.75rem; padding-bottom: 2.75rem; border-radius: 24px; background: radial-gradient(circle at top right, rgba(242, 210, 27, 0.2), transparent 30%), linear-gradient(135deg, var(--brand-navy-dark), var(--brand-navy)); color: white; box-shadow: 0 18px 40px rgba(24, 40, 61, 0.16); }
  .parts-store-icon { display: grid; place-items: center; width: 138px; height: 138px; margin: 0 auto; border-radius: 50%; background: var(--brand-gold); color: var(--brand-navy-dark); font-size: 3.75rem; }
  .parts-store-eyebrow { margin-bottom: 0.35rem; color: var(--brand-gold); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .parts-store h2 { color: white; }
  .parts-store-copy { max-width: 72ch; margin-top: 0.75rem; color: #e8eef5; }
  .parts-store-items { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .parts-store-items span { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 0.8rem; border-radius: 999px; background: rgba(255, 255, 255, 0.1); font-weight: 700; }
  .parts-store-items i { color: var(--brand-gold); }
  .parts-store-cta { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 1.5rem; padding: 0.8rem 1.15rem; border-radius: 6px; background: var(--brand-green); color: white; font-weight: 700; }
  .parts-store-cta:hover { background: var(--brand-green-dark); text-decoration: none; }
  .seo-copy { padding: 4rem 0; background: white; }
  .seo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
  .seo-grid > div { background: white; border-radius: 22px; padding: 1.75rem; box-shadow: 0 16px 34px rgba(24, 40, 61, 0.08); }
  .seo-grid p { margin-top: 0.75rem; color: var(--brand-muted); }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 2rem; margin-top: 2rem; }
  .service-item { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; padding: 2rem; background: white; border-radius: 22px; transition: all 0.3s; border: 2px solid transparent; box-shadow: 0 16px 34px rgba(24, 40, 61, 0.08); }
  .service-item:hover { border-color: var(--brand-green); transform: translateY(-4px); box-shadow: 0 8px 16px rgba(0,0,0,0.1); }
  .service-item i { font-size: 2.5rem; color: var(--brand-navy); }
  .service-item--no-icon { gap: 0; }
  .contact-section { padding: 4rem 0; background: var(--brand-navy); color: white; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .contact-form-wrapper h2 { color: white; margin-bottom: 1.5rem; }
  .contact-form-wrapper, .contact-info { background: rgba(255, 255, 255, 0.06); border-radius: 22px; padding: 1.75rem; box-shadow: 0 16px 34px rgba(8, 23, 40, 0.18); }
  .contact-form-wrapper form { display: flex; flex-direction: column; gap: 1rem; }
  .form-note { margin-bottom: 1rem; color: #d9e6d1; }
  .contact-form-wrapper input, .contact-form-wrapper textarea { padding: 12px; border: none; border-radius: 4px; font-family: inherit; }
  .contact-info h3 { color: var(--brand-gold); margin-bottom: 1rem; }
  .contact-info p { margin-bottom: 0.75rem; }
  .contact-info a { color: white; font-weight: 700; }
  .contact-info a:hover { color: var(--brand-gold); }
  .cta-text { margin-top: 1.5rem; font-style: italic; color: #d9e6d1; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 768px) {
    .hero { min-height: 0; padding: 2.2rem 0.9rem 1.65rem; align-items: center; }
    .hero-logo { width: min(320px, 74vw); margin: 0 auto 0.7rem; border-radius: 12px; }
    .hero-content h1 { font-size: 1.5rem; max-width: 15ch; }
    .hero-tagline { font-size: 0.86rem; margin-top: 0.45rem; letter-spacing: 0.2px; line-height: 1.4; }
    .intro-section, .services-overview, .parts-store, .seo-copy, .contact-section { padding: 1.8rem 0; }
    .intro-card { max-width: none; padding: 1rem; border-radius: 16px; }
    .card-icon { font-size: 2.35rem; margin-bottom: 0.8rem; }
    .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.55rem; margin-top: 0.7rem; }
    .service-item { padding: 0.72rem 0.62rem; min-height: 78px; border-radius: 14px; box-shadow: 0 6px 14px rgba(24, 40, 61, 0.05); }
    .service-item i { font-size: 1.5rem; }
    .service-item span { font-size: 0.78rem; text-align: center; line-height: 1.18; }
    .parts-store-card { grid-template-columns: 1fr; gap: 1.25rem; padding: 1.4rem 1rem; text-align: center; border-radius: 16px; }
    .parts-store-icon { width: 86px; height: 86px; font-size: 2.35rem; }
    .parts-store-eyebrow { font-size: 0.78rem; }
    .parts-store-copy { margin-top: 0.6rem; }
    .parts-store-items { justify-content: center; gap: 0.5rem; margin-top: 1rem; }
    .parts-store-items span { padding: 0.45rem 0.65rem; font-size: 0.82rem; }
    .parts-store-cta { margin-top: 1.15rem; }
    .seo-grid, .contact-grid { grid-template-columns: 1fr; gap: 1.35rem; }
    .contact-form-wrapper h2, .services-overview h2 { margin-bottom: 0.7rem; }
    .contact-form-wrapper, .contact-info, .seo-grid > div { padding: 1rem; border-radius: 16px; box-shadow: 0 6px 14px rgba(24, 40, 61, 0.05); }
  }
</style>
